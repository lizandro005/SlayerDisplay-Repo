<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- TempComm.dll é nativo de 32 bits (o XKWLib original é x86), por isso o processo tem de ser x86 -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>true</SelfContained>
    <AssemblyName>SlayerDisplay</AssemblyName>
    <RootNamespace>SlayerDisplay</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*-*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- Copia o TempComm.dll do software original para a pasta de saída, se existir -->
  <ItemGroup>
    <None Include="TempComm.dll" Condition="Exists('TempComm.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
